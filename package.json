{
  "name": "tanstack-start-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config ./src/lib/auth/server.ts --output ./src/lib/db/schemas/auth.ts",
    "build": "pnpm with-env vite build",
    "build-storybook": "storybook build",
    "commit": "cz",
    "commit:lint": "commitlint --edit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "pnpm with-env drizzle-kit migrate --config drizzle.config.ts",
    "db:reset": "pnpm with-env tsx src/lib/db/reset.ts",
    "db:seed": "pnpm with-env tsx src/lib/db/seed/index.ts",
    "db:studio": "pnpm with-env drizzle-kit studio --config drizzle.config.ts",
    "dev": "pnpm with-env vite",
    "env:login": "pnpm dlx dotenv-vault@latest login --yes",
    "env:open": "pnpm dlx dotenv-vault@latest open --yes",
    "env:pull": "pnpm dlx dotenv-vault@latest pull",
    "env:push": "pnpm dlx dotenv-vault@latest push",
    "format": "prettier -uwl --cache .",
    "format:check": "prettier -uc --cache .",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "start": "pnpm with-env pnpm srvx --prod -s ../client dist/server/server.js",
    "storybook": "storybook dev -p 6006",
    "test": "pnpm with-env vitest --project=unit run",
    "test:all": "pnpm with-env vitest run",
    "test:coverage": "pnpm with-env vitest --project=unit run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:storybook": "pnpm with-env vitest --project=storybook --run",
    "test:ui": "pnpm with-env vitest --project=unit --ui",
    "test:watch": "pnpm with-env vitest --project=unit",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenvx run --"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@base-ui-components/react": "1.0.0-rc.0",
    "@dotenvx/dotenvx": "^1.75.1",
    "@hookform/resolvers": "^5.7.1",
    "@react-email/components": "^0.5.7",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.42",
    "arktype": "^2.2.3",
    "better-auth": "^1.3.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-arktype": "^0.1.3",
    "drizzle-orm": "^0.44.6",
    "embla-carousel-react": "^8.6.0",
    "geolite2-redist": "^3.1.3",
    "input-otp": "^1.4.2",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.577.0",
    "maxmind": "^5.0.7",
    "nanoid": "^5.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-intersection-observer": "^9.16.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "2.15.4",
    "resend": "^6.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ua-parser-js": "^2.0.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.5.0",
    "@jbabin91/tsc-files": "^0.8.4",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-themes": "^9.1.20",
    "@storybook/addon-vitest": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@storybook/test": "9.0.0-alpha.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "^3.2.7",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^3.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-keys-plus": "^1.5.0",
    "eslint-plugin-storybook": "^9.1.20",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "lefthook": "^1.13.6",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^2.5.22",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "srvx": "^0.8.16",
    "storybook": "^9.1.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  }
}
